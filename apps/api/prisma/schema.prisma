generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(cuid())
  slug         String?  @unique
  title        String
  summary      String
  contribution String
  technologies String[]
  sortOrder    Int      @default(0)

  @@index([sortOrder])
}
