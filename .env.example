# Safe local-development values. Copy to .env only when running outside Compose.
POSTGRES_DB=business_card
POSTGRES_USER=business_card
POSTGRES_PASSWORD=local-development-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://business_card:local-development-only-password@localhost:5432/business_card?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
NODE_ENV=development
VITE_GRAPHQL_URL=http://localhost:3000/graphql
